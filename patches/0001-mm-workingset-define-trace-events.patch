+		__entry->folio = data->folio;
+		__entry->mapping = data->mapping;
+		__entry->index = data->index;
+		__entry->shadow = data->shadow;
+		__entry->nr_pages = data->nr_pages;
+		__entry->order = data->order;
+		__entry->dev = data->dev;
+		__entry->ino = data->ino;
+		__entry->resolved_eviction_memcg_id = data->resolved_eviction_memcg_id;
+		__entry->shadow_memcg_private_id = data->shadow_memcg_private_id;
+		__entry->shadow_nid = data->shadow_nid;
+		__entry->refault_memcg_id = data->refault_memcg_id;
+		__entry->refault_memcg_private_id = data->refault_memcg_private_id;
+		__entry->refault_nid = data->refault_nid;
+		__entry->token = data->token;
+		__entry->eviction_seq = data->eviction_seq;
+		__entry->max_seq = data->max_seq;
+		__entry->distance = data->distance;
+		__entry->current_min_seq = data->current_min_seq;
+		__entry->refs_width = data->refs_width;
+		__entry->type = data->type;
+		__entry->refs = data->refs;
+		__entry->workingset = data->workingset;
+		__entry->tier = data->tier;
+		__entry->hist = data->hist;
+		__entry->eviction_lruvec = data->eviction_lruvec;
+		__entry->refault_lruvec = data->refault_lruvec;
+		__entry->recent = data->recent;
+		__entry->same_lruvec = data->same_lruvec;
+		__entry->in_fault = data->in_fault;
+		__entry->refault_accounted = data->refault_accounted;
+		__entry->feedback_accounted = data->feedback_accounted;
+		__entry->activate_accounted = data->activate_accounted;
+		__entry->restore_accounted = data->restore_accounted;
+		__entry->refs_restored = data->refs_restored;
+		__entry->new_workingset = data->new_workingset;
+		__entry->new_refs_bits = data->new_refs_bits;
+		__entry->refaulted = data->refaulted;
+	),
+
+	TP_printk("folio=%#lx mapping=%#lx index=%lu shadow=%#lx nr_pages=%lu order=%u dev=%u ino=%llu resolved_eviction_memcg_id=%llu shadow_memcg_private_id=%u shadow_nid=%d refault_memcg_id=%llu refault_memcg_private_id=%u refault_nid=%d token=%#lx eviction_seq=%lu max_seq=%lu distance=%lu current_min_seq=%lu refs_width=%u type=%s refs=%d workingset=%d tier=%d hist=%d eviction_lruvec=%#lx refault_lruvec=%#lx recent=%d same_lruvec=%d in_fault=%d refault_accounted=%d feedback_accounted=%d activate_accounted=%d restore_accounted=%d refs_restored=%d new_workingset=%d new_refs_bits=%u refaulted=%ld",
+		  __entry->folio, __entry->mapping, __entry->index,
+		  __entry->shadow, __entry->nr_pages, __entry->order,
+		  __entry->dev, (unsigned long long)__entry->ino,
+		  (unsigned long long)__entry->resolved_eviction_memcg_id,
+		  __entry->shadow_memcg_private_id, __entry->shadow_nid,
+		  (unsigned long long)__entry->refault_memcg_id,
+		  __entry->refault_memcg_private_id, __entry->refault_nid,
+		  __entry->token, __entry->eviction_seq, __entry->max_seq,
+		  __entry->distance, __entry->current_min_seq,
+		  __entry->refs_width,
+		  __print_symbolic(__entry->type, { 0, "anon" }, { 1, "file" }),
+		  __entry->refs, __entry->workingset, __entry->tier,
+		  __entry->hist, __entry->eviction_lruvec,
+		  __entry->refault_lruvec, __entry->recent,
+		  __entry->same_lruvec, __entry->in_fault,
+		  __entry->refault_accounted, __entry->feedback_accounted,
+		  __entry->activate_accounted, __entry->restore_accounted,
+		  __entry->refs_restored, __entry->new_workingset,
+		  __entry->new_refs_bits,
+		  __entry->refaulted)
+);
+
+#endif /* _MM_WORKINGSET_TRACE_H */
+
+#undef TRACE_INCLUDE_PATH
+#define TRACE_INCLUDE_PATH ../../mm
+#undef TRACE_INCLUDE_FILE
+#define TRACE_INCLUDE_FILE workingset_trace
+
+#include <trace/define_trace.h>
